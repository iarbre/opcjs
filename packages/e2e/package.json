{
  "name": "opcjs-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end tests that exercise opcjs-client against opcjs-server in a single Node process.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iarbre/opcjs.git"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint ./tests",
    "tsc:test": "npx tsc -p tsconfig.test.json --noEmit",
    "verify": "npm run lint && npm run tsc:test && npm run test",
    "test": "vitest run",
    "test:int": "vitest run tests/integration",
    "test:dev": "vitest"
  },
  "keywords": [
    "opcua",
    "opc-ua",
    "e2e",
    "tests"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "opcjs-base": "*",
    "opcjs-client": "*",
    "opcjs-server": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "eslint": "^10.0.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.18"
  }
}
